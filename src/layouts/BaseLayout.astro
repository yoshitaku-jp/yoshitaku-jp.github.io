---
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  /** OGP の og:type。トップは website、記事ページは article を渡す。 */
  ogType?: 'website' | 'article';
  /** ページの言語。JP/EN 切り替えリンクの現在地表示にも使う。 */
  lang?: 'ja' | 'en';
}

const { title, description, ogType = 'website', lang = 'ja' } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Analytics />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta name="twitter:card" content="summary" />

    <!-- Zen Old Mincho: 見出しの明朝 / Zen Kaku Gothic New: 本文のゴシック -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500&family=Zen+Old+Mincho:wght@400;600&display=swap"
    />
  </head>

  <body>
    <nav class="lang-switch" aria-label="Language">
      <a href="/" aria-current={lang === 'ja' ? 'page' : undefined}>JA</a>
      <span class="lang-sep" aria-hidden="true">／</span>
      <a href="/en/" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
    </nav>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;

    /* 和の三色。藍を地の文、生成りを紙、朱を差し色として使う */
    --washi: #f7f4ed; /* 生成り（紙） */
    --washi-sink: #efeae1; /* 生成りを一段沈めた面 */
    --ai: #1b3552; /* 藍（本文） */
    --ai-soft: #5a6e85; /* 藍の弱いトーン（補足） */
    --shu: #c1432b; /* 朱（差し色。多用しない） */
    --line: #ded6c8; /* 罫線 */

    /*
     * 余白は 8px グリッドに拘束する。この 6 段以外の値を使わない。
     * （詳細は AGENTS.md「デザイン規約」）
     */
    --s1: 8px;
    --s2: 16px;
    --s3: 24px;
    --s4: 32px;
    --s5: 48px;
    --s6: 64px;

    --measure: 40rem;
    --measure-wide: 58rem;

    --font-mincho: 'Zen Old Mincho', 'Hiragino Mincho ProN', 'Yu Mincho', serif;
    --font-gothic: 'Zen Kaku Gothic New', 'Hiragino Sans', 'Noto Sans JP', sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    padding-block: var(--s5) var(--s6);
    padding-inline: var(--s3);
    background-color: var(--washi);
    /*
     * 芝の刈り跡（サッカー）を紙の textural なストライプとして極薄で敷く。
     * 柄として気づかせるのではなく、無地に見える程度の濃度にとどめる。
     */
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 var(--s6),
      rgba(27, 53, 82, 0.014) var(--s6) calc(var(--s6) * 2)
    );
    color: var(--ai);
    font-family: var(--font-gothic);
    font-size: 16px;
    line-height: 1.8;
    font-feature-settings: 'palt';
  }


  a {
    color: var(--ai);
    text-decoration-color: var(--line);
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    transition: text-decoration-color 0.2s ease;
  }

  a:hover {
    text-decoration-color: var(--shu);
  }

  :focus-visible {
    outline: 2px solid var(--shu);
    outline-offset: 3px;
  }

  img {
    max-width: 100%;
  }

  .lang-switch {
    max-width: var(--measure);
    margin-inline: auto;
    margin-bottom: var(--s4);
    display: flex;
    gap: var(--s1);
    font-family: var(--font-mincho);
    font-size: 13px;
    letter-spacing: 0.08em;
  }

  @media (min-width: 48rem) {
    .lang-switch {
      max-width: var(--measure-wide);
      margin-bottom: var(--s3);
    }
  }

  .lang-switch a {
    color: var(--ai-soft);
    text-decoration: none;
  }

  .lang-switch a[aria-current='page'] {
    color: var(--shu);
  }

  .lang-sep {
    color: var(--line);
  }

  /* 見た目には出さず、スクリーンリーダーにだけ伝える */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
