---
import BaseLayout from '../layouts/BaseLayout.astro';

// TODO: 自己紹介文とリンクは実際の内容に差し替える。
const profile = {
  name: 'YOSHITAKU-JP',
  role: 'DATA ENGINEER',
  summary:
    'データ基盤の設計・構築と、ETL / ELT パイプラインの運用を主な仕事にしています。データが「使える状態」で届くまでの流れを整えることに関心があります。',
};

const links: { label: string; href: string; note: string }[] = [
  { label: 'GITHUB', href: 'https://github.com/yoshitaku-jp', note: 'コードと個人プロジェクト' },
  { label: 'BLOG', href: 'https://yoshitaku-jp.hatenablog.com/', note: '技術記事（はてなブログ）' },
];

// TODO: 掲載するプロジェクト 3 件が決まったら /projects/ を追加してここから導線を張る。
---

<BaseLayout
  title={`${profile.name} | ${profile.role}`}
  description={profile.summary}
>
  <main>
    <header class="card pixel-frame">
      <p class="role">{profile.role}</p>
      <h1>{profile.name}</h1>
      <hr />
      <p class="summary">{profile.summary}</p>
    </header>

    <section aria-labelledby="links-heading">
      <h2 id="links-heading">LINKS</h2>
      <ul class="links">
        {
          links.map((link) => {
            // 外部リンクは別タブで開く。将来 /projects/ のような内部リンクを
            // 足したときは、そのまま同じタブで遷移させたいので href で判定する。
            const isExternal = link.href.startsWith('http');
            return (
              <li>
                <a
                  href={link.href}
                  target={isExternal ? '_blank' : undefined}
                  rel={isExternal ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                  {isExternal && (
                    <Fragment>
                      <span class="ext" aria-hidden="true">↗</span>
                      <span class="sr-only">（新しいタブで開く）</span>
                    </Fragment>
                  )}
                </a>
                <span class="note">{link.note}</span>
              </li>
            );
          })
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .card {
    padding: clamp(1.25rem, 5vw, 2rem);
  }

  .role {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-en);
    font-size: 0.6875rem;
    line-height: 1.6;
    letter-spacing: 0.1em;
  }

  h1 {
    margin: 0.75rem 0 0;
    font-family: var(--font-en);
    /* Press Start 2P は字幅が広いので、狭い画面では大きくしすぎない */
    font-size: clamp(1.125rem, 5.5vw, 2rem);
    line-height: 1.4;
    word-break: break-all;
  }

  hr {
    height: var(--px);
    margin: 1.25rem 0;
    border: 0;
    /* 破線ではなく「ドットが並んだ罫線」にする */
    background-image: linear-gradient(
      to right,
      var(--line) 0 var(--px),
      transparent var(--px) calc(var(--px) * 2)
    );
    background-size: calc(var(--px) * 2) var(--px);
  }

  .summary {
    margin: 0;
  }

  h2 {
    margin: 2.5rem 0 0.5rem;
    color: var(--accent);
    font-family: var(--font-en);
    font-size: 0.8125rem;
    line-height: 1.6;
    letter-spacing: 0.08em;
  }

  .links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    align-items: baseline;
    padding-block: 0.375rem;
  }

  .links a {
    font-family: var(--font-en);
    font-size: 0.75rem;
  }

  /* ▶ カーソル。常に場所を確保しておき、ホバー／フォーカス時だけ出す */
  .links a::before {
    content: '▶';
    display: inline-block;
    width: 1.5em;
    margin-left: -1.5em;
    color: var(--accent);
    visibility: hidden;
  }

  .links a:hover::before,
  .links a:focus-visible::before {
    visibility: visible;
  }

  .links li {
    padding-left: 1.5em;
  }

  .note {
    color: var(--fg-muted);
    font-size: 0.9375rem;
  }

  /* 別タブで開くことを示す矢印 */
  .ext {
    margin-left: 0.5em;
    color: var(--fg-muted);
  }

  /* 見た目には出さず、スクリーンリーダーにだけ伝える */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
